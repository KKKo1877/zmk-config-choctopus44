#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &choctopus44_layout;
        zmk,battery = &vbatt;
    };

    choctopus44_layout: choctopus44_layout {
        compatible = "zmk,physical-layout";
        display-name = "Choctopus44";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w    h    x    y   rot  rx   ry
            = <&key_physical_attrs 100  100    0  150     0   0    0>  /*  0 Q  */
            , <&key_physical_attrs 100  100  100  100     0   0    0>  /*  1 W  */
            , <&key_physical_attrs 100  100  200   50     0   0    0>  /*  2 E  */
            , <&key_physical_attrs 100  100  300    0     0   0    0>  /*  3 R  */
            , <&key_physical_attrs 100  100  400   25     0   0    0>  /*  4 T  */
            , <&key_physical_attrs 100  100  550   25     0   0    0>  /*  5 Y  */
            , <&key_physical_attrs 100  100  650    0     0   0    0>  /*  6 U  */
            , <&key_physical_attrs 100  100  750   50     0   0    0>  /*  7 I  */
            , <&key_physical_attrs 100  100  850  100     0   0    0>  /*  8 O  */
            , <&key_physical_attrs 100  100  950  150     0   0    0>  /*  9 P  */
            , <&key_physical_attrs 100  100    0  250     0   0    0>  /* 10 A  */
            , <&key_physical_attrs 100  100  100  200     0   0    0>  /* 11 S  */
            , <&key_physical_attrs 100  100  200  150     0   0    0>  /* 12 D  */
            , <&key_physical_attrs 100  100  300  100     0   0    0>  /* 13 F  */
            , <&key_physical_attrs 100  100  400  125     0   0    0>  /* 14 G  */
            , <&key_physical_attrs 100  100  550  125     0   0    0>  /* 15 H  */
            , <&key_physical_attrs 100  100  650  100     0   0    0>  /* 16 J  */
            , <&key_physical_attrs 100  100  750  150     0   0    0>  /* 17 K  */
            , <&key_physical_attrs 100  100  850  200     0   0    0>  /* 18 L  */
            , <&key_physical_attrs 100  100  950  250     0   0    0>  /* 19 ;  */
            , <&key_physical_attrs 100  100    0  350     0   0    0>  /* 20 LSHFT */
            , <&key_physical_attrs 100  100  100  300     0   0    0>  /* 21 Z  */
            , <&key_physical_attrs 100  100  200  250     0   0    0>  /* 22 X  */
            , <&key_physical_attrs 100  100  300  200     0   0    0>  /* 23 C  */
            , <&key_physical_attrs 100  100  400  225     0   0    0>  /* 24 V  */
            , <&key_physical_attrs 100  100  475  350     0   0    0>  /* 25 mid-encoder (RC(3,0)) */
            , <&key_physical_attrs 100  100  550  225     0   0    0>  /* 26 B  */
            , <&key_physical_attrs 100  100  650  200     0   0    0>  /* 27 N  */
            , <&key_physical_attrs 100  100  750  250     0   0    0>  /* 28 M  */
            , <&key_physical_attrs 100  100  850  300     0   0    0>  /* 29 ,  */
            , <&key_physical_attrs 100  100  950  350     0   0    0>  /* 30 RSHFT */
            , <&key_physical_attrs 100  100  200  350     0   0    0>  /* 31 RC(3,2) */
            , <&key_physical_attrs 100  100  300  300     0   0    0>  /* 32 RC(3,3) */
            , <&key_physical_attrs 100  100  400  325     0   0    0>  /* 33 RC(3,4) */
            , <&key_physical_attrs 100  100  500  375     0   0    0>  /* 34 RC(3,5) thumb */
            , <&key_physical_attrs 100  100  550  375     0   0    0>  /* 35 RC(7,0) thumb */
            , <&key_physical_attrs 100  100  650  325     0   0    0>  /* 36 RC(7,1) */
            , <&key_physical_attrs 100  100  750  300     0   0    0>  /* 37 RC(7,2) */
            , <&key_physical_attrs 100  100  850  325     0   0    0>  /* 38 RC(7,3) */
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <8>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)         RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)         RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,0) RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5)
                RC(3,2) RC(3,3) RC(3,4) RC(3,5)         RC(7,0) RC(7,1) RC(7,2) RC(7,3)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    middle_encoder: encoder_middle {
        compatible = "alps,ec11";
        label = "MIDDLE_ENCODER";
        a-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <20>;
        status = "okay";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&middle_encoder>;
        triggers-per-rotation = <20>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        label = "VBATT";
    };
};
