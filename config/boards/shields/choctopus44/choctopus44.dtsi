#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &choctopus44_layout;
        zmk,battery = &vbatt;
    };

    choctopus44_layout: choctopus44_layout {
        compatible = "zmk,physical-layout";
        display-name = "Choctopus44";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        
       keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100   79  14    2000  129  64>
            , <&key_physical_attrs 100 100  173  50    2000  223 100>
            , <&key_physical_attrs 100 100  284  35    2000  334  85>
            , <&key_physical_attrs 100 100  392  30    2000  442  80>
            , <&key_physical_attrs 100 100  472 108    2000  522 158>
            , <&key_physical_attrs 100 100  559 164    2000  609 214>
            , <&key_physical_attrs 100 100  686 164 (-2000)  736 214>
            , <&key_physical_attrs 100 100  774 108 (-2000)  824 158>
            , <&key_physical_attrs 100 100  853  30 (-2000)  903  80>
            , <&key_physical_attrs 100 100  961  35 (-2000) 1011  85>
            , <&key_physical_attrs 100 100 1073  50 (-2000) 1123 100>
            , <&key_physical_attrs 100 100 1167  14 (-2000) 1217  64>
            , <&key_physical_attrs 100 100   46 108    2000   96 158>
            , <&key_physical_attrs 100 100  140 144    2000  190 194>
            , <&key_physical_attrs 100 100  252 129    2000  302 179>
            , <&key_physical_attrs 100 100  360 124    2000  410 174>
            , <&key_physical_attrs 100 100  440 202    2000  490 252>
            , <&key_physical_attrs 100 100  527 258    2000  577 308>
            , <&key_physical_attrs 100 100  719 258 (-2000)  769 308>
            , <&key_physical_attrs 100 100  806 202 (-2000)  856 252>
            , <&key_physical_attrs 100 100  886 124 (-2000)  936 174>
            , <&key_physical_attrs 100 100  994 129 (-2000) 1044 179>
            , <&key_physical_attrs 100 100 1105 144 (-2000) 1155 194>
            , <&key_physical_attrs 100 100 1199 108 (-2000) 1249 158>
            , <&key_physical_attrs 100 100   14 202    2000   64 252>
            , <&key_physical_attrs 100 100  108 238    2000  158 288>
            , <&key_physical_attrs 100 100  220 223    2000  270 273>
            , <&key_physical_attrs 100 100  328 218    2000  378 268>
            , <&key_physical_attrs 100 100  408 296    2000  458 346>
            , <&key_physical_attrs 100 100  495 352    2000  545 402>
            , <&key_physical_attrs 100 100  623 423       0    0   0>
            , <&key_physical_attrs 100 100  751 352 (-2000)  801 402>
            , <&key_physical_attrs 100 100  838 296 (-2000)  888 346>
            , <&key_physical_attrs 100 100  918 218 (-2000)  968 268>
            , <&key_physical_attrs 100 100 1026 223 (-2000) 1076 273>
            , <&key_physical_attrs 100 100 1138 238 (-2000) 1188 288>
            , <&key_physical_attrs 100 100 1232 202 (-2000) 1282 252>
            , <&key_physical_attrs 100 100  264 366    1500  314 416>
            , <&key_physical_attrs 100 100  366 406    2500  416 456>
            , <&key_physical_attrs 100 100  461 464    3500  511 514>
            , <&key_physical_attrs 100 100  544 538    4500  594 588>
            , <&key_physical_attrs 100 100  701 538 (-4500)  751 588>
            , <&key_physical_attrs 100 100  785 464 (-3500)  835 514>
            , <&key_physical_attrs 100 100  880 406 (-2500)  930 456>
            , <&key_physical_attrs 100 100  982 366 (-1500) 1032 416>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <8>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)         RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)         RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,0) RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5)
                RC(3,2) RC(3,3) RC(3,4) RC(3,5)         RC(7,0) RC(7,1) RC(7,2) RC(7,3)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    middle_encoder: encoder_middle {
        compatible = "alps,ec11";
        label = "MIDDLE_ENCODER";
        a-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <20>;
        status = "okay";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&middle_encoder>;
        triggers-per-rotation = <20>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        label = "VBATT";
    };
};
