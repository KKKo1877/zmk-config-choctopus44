#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &choctopus44_layout;
        zmk,battery = &vbatt;
    };

    choctopus44_layout: choctopus44_layout {
        compatible = "zmk,physical-layout";
        display-name = "Choctopus44";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w     h      x     y     rot     rx     ry
          = <&key_physical_attrs 1800 1700   1130    510    2500   2030   1360>  /*  0 SW1  */
          , <&key_physical_attrs 1800 1700   1790    790    2500   2690   1640>  /*  1 SW2  */
          , <&key_physical_attrs 1800 1700   2660    680    2500   3560   1530>  /*  2 SW3  */
          , <&key_physical_attrs 1800 1700   3470    650    2500   4370   1500>  /*  3 SW4  */
          , <&key_physical_attrs 1800 1700   4010   1180    2500   4910   2030>  /*  4 SW5  */
          , <&key_physical_attrs 1800 1700   4620   1570    2500   5520   2420>  /*  5 SW6  */
          , <&key_physical_attrs 1800 1700   5580   1570   (-2500) 6480   2420>  /*  6 SW19 */
          , <&key_physical_attrs 1800 1700   6210   1190   (-2500) 7110   2040>  /*  7 SW20 */
          , <&key_physical_attrs 1800 1700   6760    640   (-2500) 7660   1490>  /*  8 SW21 */
          , <&key_physical_attrs 1800 1700   7560    670   (-2500) 8460   1520>  /*  9 SW22 */
          , <&key_physical_attrs 1800 1700   8430    800   (-2500) 9330   1650>  /* 10 SW23 */
          , <&key_physical_attrs 1800 1700   9100    520   (-2500) 10000  1370>  /* 11 SW24 */
          , <&key_physical_attrs 1800 1700    840   1150    2500   1740   2000>  /* 12 SW7  */
          , <&key_physical_attrs 1800 1700   1490   1460    2500   2390   2310>  /* 13 SW8  */
          , <&key_physical_attrs 1800 1700   2340   1320    2500   3240   2170>  /* 14 SW9  */
          , <&key_physical_attrs 1800 1700   3160   1310    2500   4060   2160>  /* 15 SW10 */
          , <&key_physical_attrs 1800 1700   3700   1840    2500   4600   2690>  /* 16 SW11 */
          , <&key_physical_attrs 1800 1700   4320   2220    2500   5220   3070>  /* 17 SW12 */
          , <&key_physical_attrs 1800 1700   5900   2220   (-2500) 6800   3070>  /* 18 SW25 */
          , <&key_physical_attrs 1800 1700   6530   1840   (-2500) 7430   2690>  /* 19 SW26 */
          , <&key_physical_attrs 1800 1700   7060   1290   (-2500) 7960   2140>  /* 20 SW27 */
          , <&key_physical_attrs 1800 1700   7880   1320   (-2500) 8780   2170>  /* 21 SW28 */
          , <&key_physical_attrs 1800 1700   8730   1430   (-2500) 9630   2280>  /* 22 SW29 */
          , <&key_physical_attrs 1800 1700   9410   1170   (-2500) 10310  2020>  /* 23 SW30 */
          , <&key_physical_attrs 1800 1700    520   1800    2500   1420   2650>  /* 24 SW13 */
          , <&key_physical_attrs 1800 1700   1180   2100    2500   2080   2950>  /* 25 SW14 */
          , <&key_physical_attrs 1800 1700   2030   1970    2500   2930   2820>  /* 26 SW15 */
          , <&key_physical_attrs 1800 1700   2830   1960    2500   3730   2810>  /* 27 SW16 */
          , <&key_physical_attrs 1800 1700   3390   2500    2500   4290   3350>  /* 28 SW17 */
          , <&key_physical_attrs 1800 1700   4010   2850    2500   4910   3700>  /* 29 SW18 */
          , <&key_physical_attrs 1800 1700   5100   3420       0   6000   4270>  /* 30 ENC  */
          , <&key_physical_attrs 1800 1700   6200   2870   (-2500) 7100   3720>  /* 31 SW31 */
          , <&key_physical_attrs 1800 1700   6820   2490   (-2500) 7720   3340>  /* 32 SW32 */
          , <&key_physical_attrs 1800 1700   7370   1940   (-2500) 8270   2790>  /* 33 SW33 */
          , <&key_physical_attrs 1800 1700   8180   1970   (-2500) 9080   2820>  /* 34 SW34 */
          , <&key_physical_attrs 1800 1700   9710   1810   (-2500) 10610  2660>  /* 36 SW36 */
          , <&key_physical_attrs 1800 1700   2390   3020   (-1500) 3290   3870>  /* 37 SW37 */
          , <&key_physical_attrs 1800 1700   3160   3300   (-2500) 4060   4150>  /* 38 SW38 */
          , <&key_physical_attrs 1800 1700   3880   3710   (-3500) 4780   4560>  /* 39 SW39 */
          , <&key_physical_attrs 1800 1700   4510   4240   (-4500) 5410   5090>  /* 40 SW40 */
          , <&key_physical_attrs 1800 1700   5690   4240    4500   6590   5090>  /* 41 SW41 */
          , <&key_physical_attrs 1800 1700   6330   3710    3500   7230   4560>  /* 42 SW42 */
          , <&key_physical_attrs 1800 1700   7040   3300    2500   7940   4150>  /* 43 SW43 */
          , <&key_physical_attrs 1800 1700   7820   3020    1500   8720   3870>  /* 44 SW44 */
          ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <8>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)         RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)         RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,0) RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5)
                RC(3,2) RC(3,3) RC(3,4) RC(3,5)         RC(7,0) RC(7,1) RC(7,2) RC(7,3)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    middle_encoder: encoder_middle {
        compatible = "alps,ec11";
        label = "MIDDLE_ENCODER";
        a-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <20>;
        status = "okay";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&middle_encoder>;
        triggers-per-rotation = <20>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        label = "VBATT";
    };
};
