#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &choctopus44_layout;
        zmk,battery = &vbatt;
    };

    choctopus44_layout: choctopus44_layout {
        compatible = "zmk,physical-layout";
        display-name = "Choctopus44";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        
       keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100   61    0    2000   111    50>
            , <&key_physical_attrs 100 100  150   32    2000   200    82>
            , <&key_physical_attrs 100 100  256   19    2000   306    69>
            , <&key_physical_attrs 100 100  358   15    2000   408    65>
            , <&key_physical_attrs 100 100  434   84    2000   484   134>
            , <&key_physical_attrs 100 100  516  134    2000   566   184>
            , <&key_physical_attrs 100 100  637  134 (-2000)   687   184>
            , <&key_physical_attrs 100 100  719   84 (-2000)   769   134>
            , <&key_physical_attrs 100 100  795   15 (-2000)   845    65>
            , <&key_physical_attrs 100 100  897   19 (-2000)   947    69>
            , <&key_physical_attrs 100 100 1003   32 (-2000)  1053    82>
            , <&key_physical_attrs 100 100 1092    0 (-2000)  1142    50>
            , <&key_physical_attrs 100 100   31   84    2000    81   134>
            , <&key_physical_attrs 100 100  120  116    2000   170   166>
            , <&key_physical_attrs 100 100  225  103    2000   275   153>
            , <&key_physical_attrs 100 100  328   99    2000   378   149>
            , <&key_physical_attrs 100 100  403  168    2000   453   218>
            , <&key_physical_attrs 100 100  486  218    2000   536   268>
            , <&key_physical_attrs 100 100  668  218 (-2000)   718   268>
            , <&key_physical_attrs 100 100  750  168 (-2000)   800   218>
            , <&key_physical_attrs 100 100  826   99 (-2000)   876   149>
            , <&key_physical_attrs 100 100  928  103 (-2000)   978   153>
            , <&key_physical_attrs 100 100 1034  116 (-2000)  1084   166>
            , <&key_physical_attrs 100 100 1123   84 (-2000)  1173   134>
            , <&key_physical_attrs 100 100    0  168    2000    50   218>
            , <&key_physical_attrs 100 100   89  201    2000   139   251>
            , <&key_physical_attrs 100 100  195  187    2000   245   237>
            , <&key_physical_attrs 100 100  297  183    2000   347   233>
            , <&key_physical_attrs 100 100  373  252    2000   423   302>
            , <&key_physical_attrs 100 100  455  302    2000   505   352>
            , <&key_physical_attrs 100 100  577  366       0     0     0>
            , <&key_physical_attrs 100 100  698  302 (-2000)   748   352>
            , <&key_physical_attrs 100 100  781  252 (-2000)   831   302>
            , <&key_physical_attrs 100 100  856  183 (-2000)   906   233>
            , <&key_physical_attrs 100 100  959  187 (-2000)  1009   237>
            , <&key_physical_attrs 100 100 1064  201 (-2000)  1114   251>
            , <&key_physical_attrs 100 100 1153  168 (-2000)  1203   218>
            , <&key_physical_attrs 100 100  236  315    1500   286   365>
            , <&key_physical_attrs 100 100  334  351    2500   384   401>
            , <&key_physical_attrs 100 100  423  403    3500   473   453>
            , <&key_physical_attrs 100 100  503  469    4500   553   519>
            , <&key_physical_attrs 100 100  651  469 (-4500)   701   519>
            , <&key_physical_attrs 100 100  730  403 (-3500)   780   453>
            , <&key_physical_attrs 100 100  820  351 (-2500)   870   401>
            , <&key_physical_attrs 100 100  917  315 (-1500)   967   365>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <8>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)         RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)         RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,0) RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5)
                RC(3,2) RC(3,3) RC(3,4) RC(3,5)         RC(7,0) RC(7,1) RC(7,2) RC(7,3)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    middle_encoder: encoder_middle {
        compatible = "alps,ec11";
        label = "MIDDLE_ENCODER";
        a-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <20>;
        status = "okay";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&middle_encoder>;
        triggers-per-rotation = <20>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        label = "VBATT";
    };
};
